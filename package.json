{
  "name": "shiny-race-studio",
  "version": "1.3.0",
  "description": "Patcheur de taux shiny et randomizer pour ROMs Pokémon Game Boy Advance et Nintendo DS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "test": "node test/nds.test.js && node test/scope.test.js && node test/upr.test.js"
  },
  "author": "Nawfel36cm",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "fr.shinyrace.studio",
    "productName": "Shiny Race Studio",
    "files": [
      "main.js",
      "preload.js",
      "vendor.js",
      "unzip.js",
      "src/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "zip"
      ],
      "category": "Utility"
    },
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Nawfel36cm",
        "repo": "Shiny-Race",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
